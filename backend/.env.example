# Copy to .env.local (git-ignored) and adjust. Nothing here is a real secret; generate your own values.

# --- API (backend/src/server.ts) ---
HOST=127.0.0.1
PORT=8080
# Embedded dev database (npm run db:dev): no password, loopback only. Use a real PostgreSQL 16+ URL otherwise.
DATABASE_URL=postgres://bookworm@127.0.0.1:5432/postgres
DB_POOL_MAX=1
OIDC_ISSUER=http://127.0.0.1:9000
OIDC_AUDIENCE=urn:bookworm:api
CORS_ORIGINS=http://127.0.0.1:5173
LOG_LEVEL=info
PENDING_ORDER_TTL_MINUTES=30
# Optional TLS (PEM files) for the API and the local identity provider
# TLS_KEY_FILE=
# TLS_CERT_FILE=

# --- Local identity provider (backend/src/idp/server.ts) ---
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Shared password of the demo users. Choose your own, e.g. `openssl rand -base64 18`.
IDP_DEMO_PASSWORD=
# Optional: stable cookie-signing key (random per start when empty). `openssl rand -hex 32`
IDP_COOKIE_KEY=
